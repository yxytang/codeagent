# Set these in your shell. The application does not automatically read .env files.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Other connections can bind an explicit environment variable name in Model Settings.
# A variable is used only by the connections that explicitly select it.
# MY_MODEL_API_KEY=your-other-provider-or-gateway-key
